# Deny everything, then re-include exactly what the image needs. The repo is
# 1.3 GB, 1.2 GB of which is services/ml (venv, checkpoints, datasets) — an
# allow-list is the only way that stays out of the build context by default.
*

!services/backend
!assets/models
!assets/configs
!clients/web
!proto/astra/v1/astra.proto

# Strays inside the allowed paths
services/backend/bin
services/backend/*.wav
**/__pycache__
**/.DS_Store
